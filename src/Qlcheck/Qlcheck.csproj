<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>qlcheck</AssemblyName>
    <RootNamespace>Qlcheck</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageDownload Include="coverlet.console" Version="[10.0.1]" />
  </ItemGroup>

  <Target Name="CopyCoverletConsole" AfterTargets="Build">
    <PropertyGroup>
      <CoverletSource>$(NuGetPackageRoot)coverlet.console/10.0.1/tools/net10.0/any/</CoverletSource>
    </PropertyGroup>
    <ItemGroup>
      <CoverletFile Include="$(CoverletSource)**/*.*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(CoverletFile)"
      DestinationFiles="@(CoverletFile->'$(OutputPath)coverlet/%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\..\qlfmt\src\QlFmt\QlFmt.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Qlcheck.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Languages\CSharp\Catalog\checks.json" />
  </ItemGroup>

</Project>
